*.cue
*.bin
*.BIN
*.iso
*.ISO
*.chd
*.img
*.ccd
*.sub
*.mdf
*.mds
*.pbp
*.ecm
*.zip

# BIOS / firmware dumps
scph*
SCPH*
*.rom

# Saves and states
*.srm
*.mcd
*.state

# Credentials and TLS material
.env
.env.*
*.pem
*.key
*.crt
*.p12
*.pfx
